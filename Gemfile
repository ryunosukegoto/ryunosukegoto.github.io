# Only needed if you want to preview the site locally. GitHub Pages does not use
# this file to build the live site — it builds with its own pinned toolchain.
#
#   bundle install
#   bundle exec jekyll serve      # then open http://127.0.0.1:4000
#
# Requires a modern Ruby. macOS ships Ruby 2.6, which is too old; `brew install ruby`
# and reopen your terminal first.

source "https://rubygems.org"

# Matches the versions GitHub Pages builds with, so local preview behaves like production.
gem "github-pages", group: :jekyll_plugins

# Windows/JRuby only; harmless elsewhere.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
